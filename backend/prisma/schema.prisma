generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             Int    @id @default(autoincrement())
  username       String @unique
  passwordHash   String @map("password_hash")
  role           String @default("user")
  businessName   String @default("") @map("business_name")
  cnpj           String @default("")
  phone          String @default("")
  description    String @default("")
  photoUrl       String @default("") @map("photo_url")
  address        String @default("")
  operatingHours String @default("") @map("operating_hours")
  category       String @default("barber")
  mpAccessToken  String @default("") @map("mp_access_token")
  accentColor    String @default("#f97316") @map("accent_color")
  secondaryColor String @default("#ec4899") @map("secondary_color")
  publicTheme    String @default("light") @map("public_theme")
  bannerUrl      String @default("") @map("banner_url")
  googleAccessToken  String @default("") @map("google_access_token")
  googleRefreshToken String @default("") @map("google_refresh_token")
  googleTokenExpiry  DateTime? @map("google_token_expiry")
  googleCalendarEmail String @default("") @map("google_calendar_email")
  customDomain        String? @unique @map("custom_domain")
  email               String @default("")
  resetToken          String? @map("reset_token")
  resetTokenExpiry    DateTime? @map("reset_token_expiry")
  permissions         String  @default("{}")

  // Reminder configuration
  reminderEnabled     Boolean @default(true) @map("reminder_enabled")
  reminderHours       String  @default("24,2") @map("reminder_hours")
  reminderChannels    String  @default("whatsapp") @map("reminder_channels")

  // Loyalty Program configuration
  loyaltyEnabled      Boolean @default(true) @map("loyalty_enabled")
  loyaltyTarget       Int     @default(10) @map("loyalty_target")
  loyaltyRewardType   String  @default("percentage") @map("loyalty_reward_type")
  loyaltyRewardValue  Float   @default(20.0) @map("loyalty_reward_value")

  createdAt      DateTime @default(now()) @map("created_at")

  links          SchedulingLink[]
  transactions   Transaction[]
  services       Service[]
  subscription   Subscription?
  coupons        Coupon[]
  membershipPlans MembershipPlan[]
  clientNotes    ClientNote[]
  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  employees        Employee[]
  auditLogs        AuditLog[]
  pushSubscriptions PushSubscription[]
  reminderLogs      ReminderLog[]
  loyaltyCards      LoyaltyCard[]
  userPermissions   UserPermission[]
  customerContacts  CustomerContact[]
  clientChatMessages ClientChatMessage[]
  quickReplyTemplates QuickReplyTemplate[]
  supportTickets    SupportTicket[]
  employeeAnnouncements EmployeeAnnouncement[]

  @@map("admin")
}

model Subscription {
  id             Int      @id @default(autoincrement())
  adminId        Int      @unique @map("admin_id")
  admin          Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  plan           String   @default("mensal") // "mensal" ou "anual"
  status         String   @default("trialing") // "active", "inactive", "pending", "trialing"
  externalId     String?  @map("external_id") // ID no Mercado Pago
  expiresAt      DateTime? @map("expires_at")
  trialEndsAt    DateTime? @map("trial_ends_at") // Data de fim do trial de 7 dias
  
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  duration    Int      // duration in minutes
  isUpsellable   Boolean  @default(true) @map("is_upsellable")
  upsellDiscount Float    @default(0.0) @map("upsell_discount")
  createdAt   DateTime @default(now()) @map("created_at")

  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  links       SchedulingLink[]
  mainUpsells  ServiceUpsell[] @relation("MainService")
  addonUpsells ServiceUpsell[] @relation("AddonService")

  @@map("services")
}

model ServiceUpsell {
  id            Int      @id @default(autoincrement())
  mainServiceId Int      @map("main_service_id")
  mainService   Service  @relation("MainService", fields: [mainServiceId], references: [id], onDelete: Cascade)

  addonServiceId Int     @map("addon_service_id")
  addonService   Service @relation("AddonService", fields: [addonServiceId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([mainServiceId, addonServiceId])
  @@map("service_upsells")
}

model SchedulingLink {
  id        Int        @id @default(autoincrement())
  token     String     @unique
  title     String     @default("Agendamento")
  createdAt DateTime   @default(now()) @map("created_at")
  
  adminId   Int        @map("admin_id")
  admin     Admin      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  serviceId Int?       @map("service_id")
  service   Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  
  bookingFeeEnabled Boolean @default(false) @map("booking_fee_enabled")
  bookingFeeAmount  Float   @default(0.0) @map("booking_fee_amount")
  
  deletedAt DateTime?   @map("deleted_at")
  
  timeSlots TimeSlot[]

  @@map("scheduling_links")
}

model TimeSlot {
  id          Int            @id @default(autoincrement())
  date        String
  time        String
  isAvailable Boolean        @default(true) @map("is_available")
  linkId      Int            @map("link_id")
  link        SchedulingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  booking     Booking?

  @@map("time_slots")
}

model Booking {
  id               Int      @id @default(autoincrement())
  clientName       String   @map("client_name")
  clientPhone      String   @map("client_phone")
  status           String   @default("PENDENTE")
  timeSlotId       Int      @unique @map("time_slot_id")
  timeSlot         TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  paidAmount       Float    @default(0) @map("paid_amount")
  reminderSent     Boolean  @default(false) @map("reminder_sent")
  reminder24hSent  Boolean  @default(false) @map("reminder_24h_sent")
  reminderCustomSent Boolean @default(false) @map("reminder_custom_sent")
  notes            String   @default("")
  cancellationCode String   @default("") @map("cancellation_code")
  mpPaymentId      String   @default("") @map("mp_payment_id")
  refundStatus     String   @default("NONE") @map("refund_status")
  refundAmount     Float    @default(0) @map("refund_amount")
  selectedAddons   String   @default("[]") @map("selected_addons")
  totalAmount      Float    @default(0) @map("total_amount")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("bookings")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String   // "receivable" or "payable"
  description String
  amount      Float
  dueDate     String   @map("due_date")
  paid        Boolean  @default(false)
  paidAt      String?  @map("paid_at")
  clientName  String   @default("") @map("client_name")
  category    String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Coupon {
  id            Int      @id @default(autoincrement())
  code          String
  discountType  String   @map("discount_type") // "percentage" or "fixed"
  discountValue Float    @map("discount_value")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  adminId       Int      @map("admin_id")
  admin         Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("coupons")
}

model MembershipPlan {
  id            Int      @id @default(autoincrement())
  name          String
  description   String   @default("")
  price         Float
  interval      String   // "monthly" or "yearly"
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  adminId       Int      @map("admin_id")
  admin         Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  subscriptions ClientSubscription[]

  @@map("membership_plans")
}

model ClientSubscription {
  id              Int      @id @default(autoincrement())
  clientName      String   @map("client_name")
  clientPhone     String   @map("client_phone")
  status          String   @default("active") // "active", "expired", "canceled"
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  planId          Int      @map("plan_id")
  plan            MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("client_subscriptions")
}

model ClientNote {
  id          Int      @id @default(autoincrement())
  clientPhone String   @map("client_phone")
  content     String
  createdAt   DateTime @default(now()) @map("created_at")

  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("client_notes")
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  senderId   Int      @map("sender_id")
  sender     Admin    @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId Int      @map("receiver_id")
  receiver   Admin    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Employee {
  id               Int      @id @default(autoincrement())
  name             String
  role             String
  phone            String   @default("")
  email            String   @default("")
  cpf              String   @default("")
  rg               String   @default("")
  birthDate        String   @default("") @map("birth_date")
  admissionDate    String   @default("") @map("admission_date")
  salary           Float    @default(0.0)
  commission       Float    @default(0.0)
  workingHours     String   @default("") @map("working_hours")
  
  // Portal do Funcionário credentials & settings
  passwordHash     String   @default("") @map("password_hash")
  portalToken      String   @default("") @map("portal_token")
  portalActive     Boolean  @default(true) @map("portal_active")
  address          String   @default("")
  bankAccount      String   @default("") @map("bank_account")
  
  // Status: "ACTIVE" | "DISMISSED" | "ARCHIVED"
  status           String   @default("ACTIVE")
  
  // Dismissal / Termination details
  dismissalDate    String   @default("") @map("dismissal_date")
  dismissalReason  String   @default("") @map("dismissal_reason")
  dismissalNotes   String   @default("") @map("dismissal_notes")
  
  // Pending issues (if dismissed)
  pendingType      String   @default("") @map("pending_type")
  pendingResolved  Boolean  @default(true) @map("pending_resolved")
  pendingNotes     String   @default("") @map("pending_notes")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @default(now()) @map("updated_at")

  adminId          Int      @map("admin_id")
  admin            Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  documents        EmployeeDocument[]
  timeRegisters    EmployeeTimeRegister[]
  paystubs         EmployeePaystub[]
  vacationRequests EmployeeVacationRequest[]
  accessLogs       EmployeeAccessLog[]
  profileRequests  EmployeeProfileRequest[]
  announcementReads EmployeeAnnouncementRead[]

  @@map("employees")
}

model EmployeeDocument {
  id                Int       @id @default(autoincrement())
  title             String
  category          String    @default("GERAL")
  fileUrl           String    @map("file_url")
  fileName          String    @default("") @map("file_name")
  fileSize          String    @default("") @map("file_size")
  expiryDate        String    @default("") @map("expiry_date")
  notes             String    @default("")
  requiresSignature Boolean   @default(false) @map("requires_signature")
  signed            Boolean   @default(false)
  signedAt          DateTime? @map("signed_at")
  signatureIp       String    @default("") @map("signature_ip")
  signatureStatus   String    @default("PENDING") @map("signature_status") // "PENDING", "SIGNED", "REJECTED"
  rejectionReason   String    @default("") @map("rejection_reason")
  createdAt         DateTime  @default(now()) @map("created_at")

  employeeId  Int      @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

model EmployeeTimeRegister {
  id              Int      @id @default(autoincrement())
  date            String   // YYYY-MM-DD
  entry1          String   @default("") // HH:mm
  exit1           String   @default("") // HH:mm
  entry2          String   @default("") // HH:mm
  exit2           String   @default("") // HH:mm
  totalHours      Float    @default(0.0) @map("total_hours")
  extraHours      Float    @default(0.0) @map("extra_hours")
  delayMinutes    Int      @default(0) @map("delay_minutes")
  absence         Boolean  @default(false)
  absenceReason   String   @default("") @map("absence_reason")
  status          String   @default("APPROVED") // "PENDING", "APPROVED", "DISPUTED"
  notes           String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @default(now()) @map("updated_at")

  employeeId      Int      @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_time_registers")
}

model EmployeePaystub {
  id             Int       @id @default(autoincrement())
  referenceMonth String    @map("reference_month") // MM/YYYY
  grossSalary    Float     @default(0.0) @map("gross_salary")
  netSalary      Float     @default(0.0) @map("net_salary")
  discounts      Float     @default(0.0)
  fileUrl        String    @default("") @map("file_url")
  fileName       String    @default("") @map("file_name")
  notes          String    @default("")
  signed         Boolean   @default(false)
  signedAt       DateTime? @map("signed_at")
  signatureIp    String    @default("") @map("signature_ip")
  createdAt      DateTime  @default(now()) @map("created_at")

  employeeId     Int       @map("employee_id")
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_paystubs")
}

model EmployeeVacationRequest {
  id          Int      @id @default(autoincrement())
  type        String   @default("VACATION") // "VACATION", "MEDICAL_LEAVE", "MATERNITY", "OTHER"
  startDate   String   @map("start_date") // YYYY-MM-DD
  endDate     String   @map("end_date") // YYYY-MM-DD
  daysCount   Int      @default(0) @map("days_count")
  status      String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  reason      String   @default("")
  adminNotes  String   @default("") @map("admin_notes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @default(now()) @map("updated_at")

  employeeId  Int      @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_vacation_requests")
}

model EmployeeAnnouncement {
  id          Int                       @id @default(autoincrement())
  title       String
  content     String
  targetGroup String                    @default("ALL") @map("target_group") // "ALL" ou role específico
  priority    String                    @default("NORMAL") // "NORMAL", "HIGH", "URGENT"
  createdAt   DateTime                  @default(now()) @map("created_at")

  adminId     Int                       @map("admin_id")
  admin       Admin                     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  reads       EmployeeAnnouncementRead[]

  @@map("employee_announcements")
}

model EmployeeAnnouncementRead {
  id             Int                  @id @default(autoincrement())
  announcementId Int                  @map("announcement_id")
  announcement   EmployeeAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     Int                  @map("employee_id")
  employee       Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  readAt         DateTime             @default(now()) @map("read_at")

  @@unique([announcementId, employeeId])
  @@map("employee_announcement_reads")
}

model EmployeeAccessLog {
  id         Int      @id @default(autoincrement())
  ipAddress  String   @default("") @map("ip_address")
  userAgent  String   @default("") @map("user_agent")
  action     String   @default("LOGIN")
  createdAt  DateTime @default(now()) @map("created_at")

  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_access_logs")
}

model EmployeeProfileRequest {
  id            Int      @id @default(autoincrement())
  phone         String   @default("")
  email         String   @default("")
  address       String   @default("")
  status        String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  adminNotes    String   @default("") @map("admin_notes")
  createdAt     DateTime @default(now()) @map("created_at")

  employeeId    Int      @map("employee_id")
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_profile_requests")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entity      String
  entityId    String   @default("") @map("entity_id")
  details     String   @default("")
  ipAddress   String   @default("") @map("ip_address")
  userAgent   String   @default("") @map("user_agent")
  deviceInfo  String   @default("") @map("device_info")
  severity    String   @default("INFO")
  userName    String   @default("") @map("user_name")
  userRole    String   @default("") @map("user_role")
  createdAt   DateTime @default(now()) @map("created_at")

  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model PushSubscription {
  id          Int      @id @default(autoincrement())
  endpoint    String
  p256dh      String
  auth        String
  clientPhone String   @default("") @map("client_phone")
  createdAt   DateTime @default(now()) @map("created_at")

  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model ReminderLog {
  id          Int      @id @default(autoincrement())
  bookingId   Int      @map("booking_id")
  channel     String   // "whatsapp", "email", "push"
  status      String   // "sent", "failed", "skipped"
  message     String   @default("")
  hoursLabel  String   @default("") @map("hours_label")
  clientName  String   @default("") @map("client_name")
  clientPhone String   @default("") @map("client_phone")
  createdAt   DateTime @default(now()) @map("created_at")

  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("reminder_logs")
}

model LoyaltyCard {
  id               Int      @id @default(autoincrement())
  clientPhone      String   @map("client_phone")
  clientName       String   @default("") @map("client_name")
  stampsCount      Int      @default(0) @map("stamps_count")
  rewardsEarned    Int      @default(0) @map("rewards_earned")
  rewardCouponCode String   @default("") @map("reward_coupon_code")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  adminId          Int      @map("admin_id")
  admin            Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, clientPhone])
  @@map("loyalty_cards")
}

model UserPermission {
  id                Int      @id @default(autoincrement())
  userName          String   @map("user_name")
  email             String   @default("")
  passwordHash      String   @default("") @map("password_hash")
  roleTitle         String   @default("Operador") @map("role_title") // "Gerente", "Recepcionista", "Atendente", "Barbeiro", "Financeiro"
  
  // 📅 Módulo: Operacional
  canAgendamentos   Boolean  @default(true)  @map("can_agendamentos")
  canEstornos       Boolean  @default(false) @map("can_estornos")
  canClientes       Boolean  @default(true)  @map("can_clientes")
  canHorarios       Boolean  @default(true)  @map("can_horarios")
  
  // 💼 Módulo: Comercial
  canServicos       Boolean  @default(false) @map("can_servicos")
  canLinks          Boolean  @default(false) @map("can_links")
  canCupons         Boolean  @default(false) @map("can_cupons")
  canMemberships    Boolean  @default(false) @map("can_memberships")
  
  // 💰 Módulo: Gestão & Finanças
  canFinanceiro     Boolean  @default(false) @map("can_financeiro")
  canRh             Boolean  @default(false) @map("can_rh")
  canFaturamento    Boolean  @default(false) @map("can_faturamento")
  
  // 🎨 Módulo: Sistema & Ajustes
  canSeguranca      Boolean  @default(false) @map("can_seguranca")
  canPersonalizar   Boolean  @default(false) @map("can_personalizar")
  canSocial         Boolean  @default(false) @map("can_social")
  canAudit          Boolean  @default(false) @map("can_audit")
  canTrash          Boolean  @default(false) @map("can_trash")

  // Legacy compatibility flags
  canViewBookings   Boolean  @default(true)  @map("can_view_bookings")
  canManageBookings Boolean  @default(true)  @map("can_manage_bookings")
  canViewFinance    Boolean  @default(false) @map("can_view_finance")
  canManageFinance  Boolean  @default(false) @map("can_manage_finance")
  canManageServices Boolean  @default(false) @map("can_manage_services")
  canViewClients    Boolean  @default(true)  @map("can_view_clients")
  canManageClients  Boolean  @default(false) @map("can_manage_clients")
  canManageLoyalty  Boolean  @default(false) @map("can_manage_loyalty")
  canManageStaff    Boolean  @default(false) @map("can_manage_staff")
  canManageSettings Boolean  @default(false) @map("can_manage_settings")
  canViewAuditLogs  Boolean  @default(false) @map("can_view_audit_logs")
  
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @default(now()) @map("updated_at")

  adminId           Int      @map("admin_id")
  admin             Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("user_permissions")
}

model CustomerContact {
  id              Int                 @id @default(autoincrement())
  name            String
  phone           String
  email           String              @default("")
  avatarUrl       String              @default("") @map("avatar_url")
  status          String              @default("NOVO") // "NOVO", "EM_ATENDIMENTO", "AGUARDANDO_CLIENTE", "CONCLUIDO", "VIP"
  notes           String              @default("")
  tags            String              @default("[]") // JSON string of tags e.g. ["VIP", "Fidelidade"]
  lastInteraction DateTime            @default(now()) @map("last_interaction")
  unreadCount     Int                 @default(0) @map("unread_count")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @default(now()) @map("updated_at")

  adminId         Int                 @map("admin_id")
  admin           Admin               @relation(fields: [adminId], references: [id], onDelete: Cascade)

  messages        ClientChatMessage[]

  @@unique([adminId, phone])
  @@map("customer_contacts")
}

model ClientChatMessage {
  id            Int             @id @default(autoincrement())
  senderType    String          // "STAFF" | "CLIENT"
  senderName    String          @default("") @map("sender_name")
  messageType   String          @default("TEXT") // "TEXT" | "AUDIO" | "IMAGE" | "DOCUMENT" | "LOCATION" | "TEMPLATE"
  content       String          @default("")
  mediaUrl      String          @default("") @map("media_url")
  mediaName     String          @default("") @map("media_name")
  mediaDuration Int             @default(0) @map("media_duration")
  status        String          @default("SENT") // "SENT" | "DELIVERED" | "READ"
  createdAt     DateTime        @default(now()) @map("created_at")

  contactId     Int             @map("contact_id")
  contact       CustomerContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  adminId       Int             @map("admin_id")
  admin         Admin           @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("client_chat_messages")
}

model QuickReplyTemplate {
  id        Int      @id @default(autoincrement())
  shortcut  String   // e.g. "/boas-vindas"
  title     String   // e.g. "Boas-vindas"
  content   String   // e.g. "Olá {nome}, como podemos te ajudar hoje?"
  category  String   @default("GERAL") // "GERAL", "AGENDAMENTO", "FINANCEIRO", "PROMOCAO"
  createdAt DateTime @default(now()) @map("created_at")

  adminId   Int      @map("admin_id")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("quick_reply_templates")
}

model SupportTicket {
  id          Int              @id @default(autoincrement())
  subject     String
  category    String           @default("DUVIDA") // DUVIDA, FINANCEIRO, TECNICO, SUGESTAO
  status      String           @default("OPEN")    // OPEN, IN_PROGRESS, RESOLVED
  priority    String           @default("NORMAL")  // NORMAL, HIGH, URGENT
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  adminId     Int              @map("admin_id")
  admin       Admin            @relation(fields: [adminId], references: [id], onDelete: Cascade)

  messages    SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id          Int           @id @default(autoincrement())
  ticketId    Int           @map("ticket_id")
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole  String        @map("sender_role") // "USER" | "SUPERADMIN"
  senderName  String        @map("sender_name")
  message     String
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("support_messages")
}


