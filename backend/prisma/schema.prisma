generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             Int    @id @default(autoincrement())
  username       String @unique
  passwordHash   String @map("password_hash")
  role           String @default("user")
  businessName   String @default("") @map("business_name")
  cnpj           String @default("")
  phone          String @default("")
  description    String @default("")
  photoUrl       String @default("") @map("photo_url")
  address        String @default("")
  ie             String @default("") // Inscrição Estadual
  taxRegime      String @default("MEI") @map("tax_regime") // "MEI" | "SIMPLES_NACIONAL" | "LUCRO_PRESUMIDO"
  nfeSeries      String @default("1") @map("nfe_series")
  nfeNextNumber  Int    @default(1) @map("nfe_next_number")
  nfceSeries     String @default("1") @map("nfce_series")
  nfceNextNumber Int    @default(1) @map("nfce_next_number")
  operatingHours String @default("") @map("operating_hours")
  category       String @default("barber")
  businessType   String @default("SERVICES") @map("business_type") // "SERVICES" (BoraMarka) | "PRODUCTS" (BoraEnkomenda)
  mpAccessToken  String @default("") @map("mp_access_token")
  pixKey         String @default("") @map("pix_key")
  accentColor    String @default("#f97316") @map("accent_color")
  secondaryColor String @default("#ec4899") @map("secondary_color")
  publicTheme    String @default("light") @map("public_theme")
  bannerUrl      String @default("") @map("banner_url")
  googleAccessToken  String @default("") @map("google_access_token")
  googleRefreshToken String @default("") @map("google_refresh_token")
  googleTokenExpiry  DateTime? @map("google_token_expiry")
  googleCalendarEmail String @default("") @map("google_calendar_email")
  customDomain        String? @unique @map("custom_domain")
  email               String @default("")
  resetToken          String? @map("reset_token")
  resetTokenExpiry    DateTime? @map("reset_token_expiry")
  permissions         String  @default("{}")

  // Reminder configuration
  reminderEnabled     Boolean @default(true) @map("reminder_enabled")
  reminderHours       String  @default("24,2") @map("reminder_hours")
  reminderChannels    String  @default("whatsapp") @map("reminder_channels")

  // Loyalty Program configuration
  loyaltyEnabled      Boolean @default(true) @map("loyalty_enabled")
  loyaltyTarget       Int     @default(10) @map("loyalty_target")
  loyaltyRewardType   String  @default("percentage") @map("loyalty_reward_type")
  loyaltyRewardValue  Float   @default(20.0) @map("loyalty_reward_value")

  createdAt      DateTime @default(now()) @map("created_at")

  links          SchedulingLink[]
  transactions   Transaction[]
  services       Service[]
  subscription   Subscription?
  coupons        Coupon[]
  membershipPlans MembershipPlan[]
  clientNotes    ClientNote[]
  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  employees        Employee[]
  auditLogs        AuditLog[]
  pushSubscriptions PushSubscription[]
  reminderLogs      ReminderLog[]
  loyaltyCards      LoyaltyCard[]
  userPermissions   UserPermission[]
  customerContacts  CustomerContact[]
  clientChatMessages ClientChatMessage[]
  quickReplyTemplates QuickReplyTemplate[]
  supportTickets    SupportTicket[]
  employeeAnnouncements EmployeeAnnouncement[]
  refreshTokens     RefreshToken[]
  serviceReviews    ServiceReview[]
  orderSettings     OrderSettings?
  productCategories ProductCategory[]
  products          Product[]
  orders            Order[]
  walkInQueue       WalkInQueue[]
  inventoryItems    InventoryItem[]
  saleTransactions  SaleTransaction[]
  marketingCampaigns MarketingCampaign[]
  suppliers         Supplier[]
  purchases         Purchase[]
  invoices          Invoice[]
  shoppingLists     ShoppingList[]

  @@map("admin")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  adminId   Int      @map("admin_id")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Subscription {
  id             Int      @id @default(autoincrement())
  adminId        Int      @unique @map("admin_id")
  admin          Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  plan           String   @default("mensal") // "mensal" ou "anual"
  status         String   @default("trialing") // "active", "inactive", "pending", "trialing"
  externalId     String?  @map("external_id") // ID no Mercado Pago
  expiresAt      DateTime? @map("expires_at")
  trialEndsAt    DateTime? @map("trial_ends_at") // Data de fim do trial de 7 dias
  
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  duration    Int      // duration in minutes
  photoUrl    String   @default("") @map("photo_url")
  isUpsellable   Boolean  @default(true) @map("is_upsellable")
  upsellDiscount Float    @default(0.0) @map("upsell_discount")
  createdAt   DateTime @default(now()) @map("created_at")

  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  links       SchedulingLink[]
  mainUpsells  ServiceUpsell[] @relation("MainService")
  addonUpsells ServiceUpsell[] @relation("AddonService")
  reviews      ServiceReview[]

  @@map("services")
}

model ServiceUpsell {
  id            Int      @id @default(autoincrement())
  mainServiceId Int      @map("main_service_id")
  mainService   Service  @relation("MainService", fields: [mainServiceId], references: [id], onDelete: Cascade)

  addonServiceId Int     @map("addon_service_id")
  addonService   Service @relation("AddonService", fields: [addonServiceId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([mainServiceId, addonServiceId])
  @@map("service_upsells")
}

model SchedulingLink {
  id        Int        @id @default(autoincrement())
  token     String     @unique
  title     String     @default("Agendamento")
  createdAt DateTime   @default(now()) @map("created_at")
  
  adminId   Int        @map("admin_id")
  admin     Admin      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  serviceId Int?       @map("service_id")
  service   Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  
  bookingFeeEnabled Boolean @default(false) @map("booking_fee_enabled")
  bookingFeeAmount  Float   @default(0.0) @map("booking_fee_amount")
  
  deletedAt DateTime?   @map("deleted_at")
  
  timeSlots TimeSlot[]

  @@index([adminId])
  @@map("scheduling_links")
}

model TimeSlot {
  id          Int            @id @default(autoincrement())
  date        String
  time        String
  isAvailable Boolean        @default(true) @map("is_available")
  linkId      Int            @map("link_id")
  link        SchedulingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  booking     Booking?

  @@index([linkId])
  @@index([date])
  @@map("time_slots")
}

model Booking {
  id               Int      @id @default(autoincrement())
  clientName       String   @map("client_name")
  clientPhone      String   @map("client_phone")
  clientEmail      String   @default("") @map("client_email")
  status           String   @default("PENDENTE")
  timeSlotId       Int      @unique @map("time_slot_id")
  timeSlot         TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  paidAmount       Float    @default(0) @map("paid_amount")
  reminderSent     Boolean  @default(false) @map("reminder_sent")
  reminder24hSent  Boolean  @default(false) @map("reminder_24h_sent")
  reminderCustomSent Boolean @default(false) @map("reminder_custom_sent")
  notes            String   @default("")
  cancellationCode String   @default("") @map("cancellation_code")
  mpPaymentId      String   @default("") @map("mp_payment_id")
  refundStatus     String   @default("NONE") @map("refund_status")
  refundAmount     Float    @default(0) @map("refund_amount")
  selectedAddons   String   @default("[]") @map("selected_addons")
  totalAmount      Float    @default(0) @map("total_amount")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([clientPhone])
  @@map("bookings")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String   // "receivable" or "payable"
  description String
  amount      Float
  dueDate     String   @map("due_date")
  paid        Boolean  @default(false)
  paidAt      String?  @map("paid_at")
  clientName  String   @default("") @map("client_name")
  category    String   @default("")
  notes       String   @default("")
  supplierId  Int?     @map("supplier_id")
  invoiceId   Int?     @map("invoice_id")
  purchaseId  Int?     @map("purchase_id")
  createdAt   DateTime @default(now()) @map("created_at")

  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([dueDate])
  @@index([type])
  @@map("transactions")
}

model Coupon {
  id            Int      @id @default(autoincrement())
  code          String
  discountType  String   @map("discount_type") // "percentage" or "fixed"
  discountValue Float    @map("discount_value")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  adminId       Int      @map("admin_id")
  admin         Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("coupons")
}

model MembershipPlan {
  id            Int      @id @default(autoincrement())
  name          String
  description   String   @default("")
  price         Float
  interval      String   // "monthly" or "yearly"
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  adminId       Int      @map("admin_id")
  admin         Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  subscriptions ClientSubscription[]

  @@map("membership_plans")
}

model ClientSubscription {
  id              Int      @id @default(autoincrement())
  clientName      String   @map("client_name")
  clientPhone     String   @map("client_phone")
  status          String   @default("active") // "active", "expired", "canceled"
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  planId          Int      @map("plan_id")
  plan            MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("client_subscriptions")
}

model ClientNote {
  id          Int      @id @default(autoincrement())
  clientPhone String   @map("client_phone")
  content     String
  createdAt   DateTime @default(now()) @map("created_at")

  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("client_notes")
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  senderId   Int      @map("sender_id")
  sender     Admin    @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId Int      @map("receiver_id")
  receiver   Admin    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Employee {
  id               Int      @id @default(autoincrement())
  name             String
  role             String
  phone            String   @default("")
  email            String   @default("")
  cpf              String   @default("")
  rg               String   @default("")
  birthDate        String   @default("") @map("birth_date")
  admissionDate    String   @default("") @map("admission_date")
  salary           Float    @default(0.0)
  commission       Float    @default(0.0)
  workingHours     String   @default("") @map("working_hours")
  
  // Portal do Funcionário credentials & settings
  passwordHash     String   @default("") @map("password_hash")
  portalToken      String   @default("") @map("portal_token")
  portalActive     Boolean  @default(true) @map("portal_active")
  address          String   @default("")
  bankAccount      String   @default("") @map("bank_account")
  
  // Status: "ACTIVE" | "DISMISSED" | "ARCHIVED"
  status           String   @default("ACTIVE")
  
  // Dismissal / Termination details
  dismissalDate    String   @default("") @map("dismissal_date")
  dismissalReason  String   @default("") @map("dismissal_reason")
  dismissalNotes   String   @default("") @map("dismissal_notes")
  
  // Pending issues (if dismissed)
  pendingType      String   @default("") @map("pending_type")
  pendingResolved  Boolean  @default(true) @map("pending_resolved")
  pendingNotes     String   @default("") @map("pending_notes")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @default(now()) @map("updated_at")

  adminId          Int      @map("admin_id")
  admin            Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  documents        EmployeeDocument[]
  timeRegisters    EmployeeTimeRegister[]
  paystubs         EmployeePaystub[]
  vacationRequests EmployeeVacationRequest[]
  accessLogs       EmployeeAccessLog[]
  profileRequests  EmployeeProfileRequest[]
  announcementReads EmployeeAnnouncementRead[]

  @@map("employees")
}

model EmployeeDocument {
  id                Int       @id @default(autoincrement())
  title             String
  category          String    @default("GERAL")
  fileUrl           String    @map("file_url")
  fileName          String    @default("") @map("file_name")
  fileSize          String    @default("") @map("file_size")
  expiryDate        String    @default("") @map("expiry_date")
  notes             String    @default("")
  requiresSignature Boolean   @default(false) @map("requires_signature")
  signed            Boolean   @default(false)
  signedAt          DateTime? @map("signed_at")
  signatureIp       String    @default("") @map("signature_ip")
  signatureStatus   String    @default("PENDING") @map("signature_status") // "PENDING", "SIGNED", "REJECTED"
  rejectionReason   String    @default("") @map("rejection_reason")
  createdAt         DateTime  @default(now()) @map("created_at")

  employeeId  Int      @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

model EmployeeTimeRegister {
  id              Int      @id @default(autoincrement())
  date            String   // YYYY-MM-DD
  entry1          String   @default("") // HH:mm
  exit1           String   @default("") // HH:mm
  entry2          String   @default("") // HH:mm
  exit2           String   @default("") // HH:mm
  totalHours      Float    @default(0.0) @map("total_hours")
  extraHours      Float    @default(0.0) @map("extra_hours")
  delayMinutes    Int      @default(0) @map("delay_minutes")
  absence         Boolean  @default(false)
  absenceReason   String   @default("") @map("absence_reason")
  status          String   @default("APPROVED") // "PENDING", "APPROVED", "DISPUTED"
  notes           String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @default(now()) @map("updated_at")

  employeeId      Int      @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_time_registers")
}

model EmployeePaystub {
  id             Int       @id @default(autoincrement())
  referenceMonth String    @map("reference_month") // MM/YYYY
  grossSalary    Float     @default(0.0) @map("gross_salary")
  netSalary      Float     @default(0.0) @map("net_salary")
  discounts      Float     @default(0.0)
  fileUrl        String    @default("") @map("file_url")
  fileName       String    @default("") @map("file_name")
  notes          String    @default("")
  signed         Boolean   @default(false)
  signedAt       DateTime? @map("signed_at")
  signatureIp    String    @default("") @map("signature_ip")
  createdAt      DateTime  @default(now()) @map("created_at")

  employeeId     Int       @map("employee_id")
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_paystubs")
}

model EmployeeVacationRequest {
  id          Int      @id @default(autoincrement())
  type        String   @default("VACATION") // "VACATION", "MEDICAL_LEAVE", "MATERNITY", "OTHER"
  startDate   String   @map("start_date") // YYYY-MM-DD
  endDate     String   @map("end_date") // YYYY-MM-DD
  daysCount   Int      @default(0) @map("days_count")
  status      String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  reason      String   @default("")
  adminNotes  String   @default("") @map("admin_notes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @default(now()) @map("updated_at")

  employeeId  Int      @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_vacation_requests")
}

model EmployeeAnnouncement {
  id          Int                       @id @default(autoincrement())
  title       String
  content     String
  targetGroup String                    @default("ALL") @map("target_group") // "ALL" ou role específico
  priority    String                    @default("NORMAL") // "NORMAL", "HIGH", "URGENT"
  createdAt   DateTime                  @default(now()) @map("created_at")

  adminId     Int                       @map("admin_id")
  admin       Admin                     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  reads       EmployeeAnnouncementRead[]

  @@map("employee_announcements")
}

model EmployeeAnnouncementRead {
  id             Int                  @id @default(autoincrement())
  announcementId Int                  @map("announcement_id")
  announcement   EmployeeAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     Int                  @map("employee_id")
  employee       Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  readAt         DateTime             @default(now()) @map("read_at")

  @@unique([announcementId, employeeId])
  @@map("employee_announcement_reads")
}

model EmployeeAccessLog {
  id         Int      @id @default(autoincrement())
  ipAddress  String   @default("") @map("ip_address")
  userAgent  String   @default("") @map("user_agent")
  action     String   @default("LOGIN")
  createdAt  DateTime @default(now()) @map("created_at")

  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_access_logs")
}

model EmployeeProfileRequest {
  id            Int      @id @default(autoincrement())
  phone         String   @default("")
  email         String   @default("")
  address       String   @default("")
  status        String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  adminNotes    String   @default("") @map("admin_notes")
  createdAt     DateTime @default(now()) @map("created_at")

  employeeId    Int      @map("employee_id")
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_profile_requests")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entity      String
  entityId    String   @default("") @map("entity_id")
  details     String   @default("")
  ipAddress   String   @default("") @map("ip_address")
  userAgent   String   @default("") @map("user_agent")
  deviceInfo  String   @default("") @map("device_info")
  severity    String   @default("INFO")
  userName    String   @default("") @map("user_name")
  userRole    String   @default("") @map("user_role")
  createdAt   DateTime @default(now()) @map("created_at")

  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PushSubscription {
  id          Int      @id @default(autoincrement())
  endpoint    String
  p256dh      String
  auth        String
  clientPhone String   @default("") @map("client_phone")
  createdAt   DateTime @default(now()) @map("created_at")

  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model ReminderLog {
  id          Int      @id @default(autoincrement())
  bookingId   Int      @map("booking_id")
  channel     String   // "whatsapp", "email", "push"
  status      String   // "sent", "failed", "skipped"
  message     String   @default("")
  hoursLabel  String   @default("") @map("hours_label")
  clientName  String   @default("") @map("client_name")
  clientPhone String   @default("") @map("client_phone")
  createdAt   DateTime @default(now()) @map("created_at")

  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("reminder_logs")
}

model LoyaltyCard {
  id               Int      @id @default(autoincrement())
  clientPhone      String   @map("client_phone")
  clientName       String   @default("") @map("client_name")
  stampsCount      Int      @default(0) @map("stamps_count")
  rewardsEarned    Int      @default(0) @map("rewards_earned")
  rewardCouponCode String   @default("") @map("reward_coupon_code")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  adminId          Int      @map("admin_id")
  admin            Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, clientPhone])
  @@map("loyalty_cards")
}

model UserPermission {
  id                Int      @id @default(autoincrement())
  userName          String   @map("user_name")
  email             String   @default("")
  passwordHash      String   @default("") @map("password_hash")
  roleTitle         String   @default("Operador") @map("role_title") // "Gerente", "Recepcionista", "Atendente", "Barbeiro", "Financeiro"
  
  // 📅 Módulo: Operacional
  canAgendamentos   Boolean  @default(true)  @map("can_agendamentos")
  canEstornos       Boolean  @default(false) @map("can_estornos")
  canClientes       Boolean  @default(true)  @map("can_clientes")
  canHorarios       Boolean  @default(true)  @map("can_horarios")
  
  // 💼 Módulo: Comercial
  canServicos       Boolean  @default(false) @map("can_servicos")
  canLinks          Boolean  @default(false) @map("can_links")
  canCupons         Boolean  @default(false) @map("can_cupons")
  canMemberships    Boolean  @default(false) @map("can_memberships")
  
  // 💰 Módulo: Gestão & Finanças
  canFinanceiro     Boolean  @default(false) @map("can_financeiro")
  canRh             Boolean  @default(false) @map("can_rh")
  canFaturamento    Boolean  @default(false) @map("can_faturamento")
  
  // 🎨 Módulo: Sistema & Ajustes
  canSeguranca      Boolean  @default(false) @map("can_seguranca")
  canPersonalizar   Boolean  @default(false) @map("can_personalizar")
  canSocial         Boolean  @default(false) @map("can_social")
  canAudit          Boolean  @default(false) @map("can_audit")
  canTrash          Boolean  @default(false) @map("can_trash")

  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @default(now()) @map("updated_at")

  adminId           Int      @map("admin_id")
  admin             Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("user_permissions")
}

model CustomerContact {
  id              Int                 @id @default(autoincrement())
  name            String
  phone           String
  email           String              @default("")
  avatarUrl       String              @default("") @map("avatar_url")
  status          String              @default("NOVO") // "NOVO", "EM_ATENDIMENTO", "AGUARDANDO_CLIENTE", "CONCLUIDO", "VIP"
  notes           String              @default("")
  tags            String              @default("[]") // JSON string of tags e.g. ["VIP", "Fidelidade"]
  lastInteraction DateTime            @default(now()) @map("last_interaction")
  unreadCount     Int                 @default(0) @map("unread_count")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @default(now()) @map("updated_at")

  adminId         Int                 @map("admin_id")
  admin           Admin               @relation(fields: [adminId], references: [id], onDelete: Cascade)

  messages        ClientChatMessage[]

  @@unique([adminId, phone])
  @@map("customer_contacts")
}

model ClientChatMessage {
  id            Int             @id @default(autoincrement())
  senderType    String          // "STAFF" | "CLIENT"
  senderName    String          @default("") @map("sender_name")
  messageType   String          @default("TEXT") // "TEXT" | "AUDIO" | "IMAGE" | "DOCUMENT" | "LOCATION" | "TEMPLATE"
  content       String          @default("")
  mediaUrl      String          @default("") @map("media_url")
  mediaName     String          @default("") @map("media_name")
  mediaDuration Int             @default(0) @map("media_duration")
  status        String          @default("SENT") // "SENT" | "DELIVERED" | "READ"
  createdAt     DateTime        @default(now()) @map("created_at")

  contactId     Int             @map("contact_id")
  contact       CustomerContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  adminId       Int             @map("admin_id")
  admin         Admin           @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("client_chat_messages")
}

model QuickReplyTemplate {
  id        Int      @id @default(autoincrement())
  shortcut  String   // e.g. "/boas-vindas"
  title     String   // e.g. "Boas-vindas"
  content   String   // e.g. "Olá {nome}, como podemos te ajudar hoje?"
  category  String   @default("GERAL") // "GERAL", "AGENDAMENTO", "FINANCEIRO", "PROMOCAO"
  createdAt DateTime @default(now()) @map("created_at")

  adminId   Int      @map("admin_id")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("quick_reply_templates")
}

model SupportTicket {
  id                  Int                 @id @default(autoincrement())
  subject             String
  category            String              @default("DUVIDA") // DUVIDA, FINANCEIRO, TECNICO, SUGESTAO
  status              String              @default("OPEN")    // OPEN, IN_PROGRESS, RESOLVED
  priority            String              @default("NORMAL")  // NORMAL, HIGH, URGENT
  slaDeadline         DateTime?           @map("sla_deadline")
  satisfactionRating  Int?                @map("satisfaction_rating")
  satisfactionComment String?             @default("") @map("satisfaction_comment")
  tags                String              @default("[]")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  adminId             Int                 @map("admin_id")
  admin               Admin               @relation(fields: [adminId], references: [id], onDelete: Cascade)

  messages            SupportMessage[]
  statusLogs          SupportStatusLog[]

  @@map("support_tickets")
}

model SupportMessage {
  id             Int           @id @default(autoincrement())
  ticketId       Int           @map("ticket_id")
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole     String        @map("sender_role") // "USER" | "SUPERADMIN"
  senderName     String        @map("sender_name")
  message        String
  attachmentUrl  String        @default("") @map("attachment_url")
  attachmentName String        @default("") @map("attachment_name")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@map("support_messages")
}

model SupportStatusLog {
  id        Int           @id @default(autoincrement())
  ticketId  Int           @map("ticket_id")
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  oldStatus String        @map("old_status")
  newStatus String        @map("new_status")
  changedBy String        @map("changed_by")
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("support_status_logs")
}

model SupportReplyTemplate {
  id        Int      @id @default(autoincrement())
  title     String
  category  String   @default("GERAL")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("support_reply_templates")
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("verification_codes")
}

model ServiceReview {
  id          Int      @id @default(autoincrement())
  rating      Int
  comment     String   @default("")
  clientName  String   @map("client_name")
  clientPhone String   @map("client_phone")
  
  serviceId   Int      @map("service_id")
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  bookingId   Int?     @unique @map("booking_id")
  
  approved    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("service_reviews")
}

// ═══════════════════════════════════════════════════════════
// 🍰 Módulo BoraEnkomenda (Sistema de Encomendas & Cardápio)
// ═══════════════════════════════════════════════════════════

model OrderSettings {
  id                   Int      @id @default(autoincrement())
  adminId              Int      @unique @map("admin_id")
  admin                Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  enabled              Boolean  @default(true)
  storeName            String   @default("") @map("store_name")
  storeDescription     String   @default("") @map("store_description")
  bannerUrl            String   @default("") @map("banner_url")
  minOrderAmount       Float    @default(0.0) @map("min_order_amount")
  depositPercentage    Float    @default(50.0) @map("deposit_percentage") // % de entrada (ex: 50%)
  allowScheduledPickup Boolean  @default(true) @map("allow_scheduled_pickup")
  allowDelivery        Boolean  @default(true) @map("allow_delivery")
  deliveryFee          Float    @default(0.0) @map("delivery_fee")
  minAdvanceDays       Int      @default(2) @map("min_advance_days") // antecedência mínima global em dias
  whatsappNotifications Boolean @default(true) @map("whatsapp_notifications")
  pixKey               String   @default("") @map("pix_key")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @default(now()) @map("updated_at")

  @@map("order_settings")
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  name      String
  iconUrl   String    @default("") @map("icon_url")
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  adminId   Int       @map("admin_id")
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([adminId])
  @@map("product_categories")
}

model Product {
  id                  Int                  @id @default(autoincrement())
  name                String
  description         String               @default("")
  price               Float
  minDaysNotice       Int                  @default(2) @map("min_days_notice") // prazo mínimo de produção em dias
  maxQuantityPerOrder Int                  @default(99) @map("max_quantity_per_order")
  unitLabel           String               @default("unidade") @map("unit_label") // "unidade", "kg", "cento", "fatia"
  available           Boolean              @default(true)
  featured            Boolean              @default(false)
  position            Int                  @default(0)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @default(now()) @map("updated_at")

  adminId             Int                  @map("admin_id")
  admin               Admin                @relation(fields: [adminId], references: [id], onDelete: Cascade)

  categoryId          Int?                 @map("category_id")
  category            ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  photos              ProductPhoto[]
  customFields        ProductCustomField[]
  orderItems          OrderItem[]

  @@index([adminId])
  @@index([categoryId])
  @@map("products")
}

model ProductPhoto {
  id        Int      @id @default(autoincrement())
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_photos")
}

model ProductCustomField {
  id        Int      @id @default(autoincrement())
  label     String   // Ex: "Sabor da massa", "Recheio", "Nome e idade para topo"
  fieldType String   @default("TEXT") @map("field_type") // "TEXT" | "SELECT" | "CHECKBOX"
  options   String   @default("[]") // JSON Array com as opções, ex: ["Chocolate Belga", "Ninho com Nutella"]
  required  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_custom_fields")
}

model Order {
  id               Int              @id @default(autoincrement())
  orderNumber      String           @unique @map("order_number") // Ex: "#ENK-1042"
  clientName       String           @map("client_name")
  clientPhone      String           @map("client_phone")
  clientEmail      String           @default("") @map("client_email")
  deliveryDate     String           @map("delivery_date") // "YYYY-MM-DD"
  deliveryTime     String           @default("14:00") @map("delivery_time") // "HH:MM"
  deliveryType     String           @default("PICKUP") @map("delivery_type") // "PICKUP" | "DELIVERY"
  deliveryAddress  String           @default("") @map("delivery_address")
  status           String           @default("NOVO") // "NOVO" | "CONFIRMADO" | "EM_PRODUCAO" | "PRONTO" | "ENTREGUE" | "CANCELADO"
  notes            String           @default("")
  subtotal         Float            @default(0.0)
  deliveryFee      Float            @default(0.0) @map("delivery_fee")
  discount         Float            @default(0.0)
  total            Float            @default(0.0)
  depositPercentage Float           @default(50.0) @map("deposit_percentage")
  depositAmount    Float            @default(0.0) @map("deposit_amount")
  depositPaid      Boolean          @default(false) @map("deposit_paid")
  remainingAmount  Float            @default(0.0) @map("remaining_amount")
  mpPaymentId      String           @default("") @map("mp_payment_id")
  cancellationCode String           @default("") @map("cancellation_code")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @default(now()) @map("updated_at")

  adminId          Int              @map("admin_id")
  admin            Admin            @relation(fields: [adminId], references: [id], onDelete: Cascade)

  items            OrderItem[]
  statusLogs       OrderStatusLog[]
  shoppingLists    ShoppingList[]

  @@index([adminId])
  @@index([deliveryDate])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             Int      @id @default(autoincrement())
  productName    String   @default("") @map("product_name")
  quantity       Int      @default(1)
  unitPrice      Float    @map("unit_price")
  subtotal       Float
  customizations String   @default("{}") // JSON com as respostas do cliente
  notes          String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")

  orderId        Int      @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId      Int?     @map("product_id")
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusLog {
  id        Int      @id @default(autoincrement())
  oldStatus String   @map("old_status")
  newStatus String   @map("new_status")
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  orderId   Int      @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_logs")
}

// ═══════════════════════════════════════════════════════════════
// FILA DE ESPERA / WALK-IN
// ═══════════════════════════════════════════════════════════════
model WalkInQueue {
  id            Int       @id @default(autoincrement())
  clientName    String    @map("client_name")
  clientPhone   String    @map("client_phone")
  serviceName   String    @default("") @map("service_name")
  employeeId    Int?      @map("employee_id")
  status        String    @default("WAITING") // WAITING | CALLED | IN_SERVICE | DONE | CANCELLED
  position      Int       @default(0)
  estimatedWait Int       @default(0) @map("estimated_wait") // minutos
  notified      Boolean   @default(false)
  notes         String    @default("")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  adminId       Int       @map("admin_id")
  admin         Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([status])
  @@map("walk_in_queue")
}

// ═══════════════════════════════════════════════════════════════
// CONTROLE DE ESTOQUE
// ═══════════════════════════════════════════════════════════════
model InventoryItem {
  id           Int             @id @default(autoincrement())
  name         String
  description  String          @default("")
  category     String          @default("PRODUTO") // PRODUTO | INSUMO
  unit         String          @default("unidade")
  costPrice    Float           @default(0.0) @map("cost_price")
  salePrice    Float           @default(0.0) @map("sale_price")
  quantity     Int             @default(0)
  minQuantity  Int             @default(5) @map("min_quantity")
  photoUrl     String          @default("") @map("photo_url")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  adminId      Int             @map("admin_id")
  admin        Admin           @relation(fields: [adminId], references: [id], onDelete: Cascade)

  movements     StockMovement[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  invoiceItems  InvoiceItem[]

  @@index([adminId])
  @@map("inventory_items")
}

model StockMovement {
  id          Int           @id @default(autoincrement())
  type        String        // ENTRADA | SAIDA | AJUSTE
  quantity    Int
  reason      String        @default("")
  createdAt   DateTime      @default(now()) @map("created_at")

  itemId      Int           @map("item_id")
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("stock_movements")
}

// ═══════════════════════════════════════════════════════════════
// PDV — PONTO DE VENDA
// ═══════════════════════════════════════════════════════════════
model SaleTransaction {
  id            Int        @id @default(autoincrement())
  bookingId     Int?       @unique @map("booking_id")
  employeeId    Int?       @map("employee_id")
  total         Float      @default(0.0)
  discount      Float      @default(0.0)
  paymentMethod String     @default("PIX") @map("payment_method") // PIX | DINHEIRO | DEBITO | CREDITO
  status        String     @default("PAID") // PAID | CANCELLED
  receiptSent   Boolean    @default(false) @map("receipt_sent")
  notes         String     @default("")
  createdAt     DateTime   @default(now()) @map("created_at")

  adminId       Int        @map("admin_id")
  admin         Admin      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  items         SaleItem[]

  @@index([adminId])
  @@index([createdAt])
  @@map("sale_transactions")
}

model SaleItem {
  id              Int              @id @default(autoincrement())
  name            String
  quantity        Int              @default(1)
  unitPrice       Float            @map("unit_price")
  subtotal        Float
  itemType        String           @default("SERVICE") @map("item_type") // SERVICE | PRODUCT | CUSTOM
  inventoryItemId Int?             @map("inventory_item_id")
  inventoryItem   InventoryItem?   @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  saleId          Int              @map("sale_id")
  sale            SaleTransaction  @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_items")
}

// ═══════════════════════════════════════════════════════════════
// CAMPANHAS DE MARKETING
// ═══════════════════════════════════════════════════════════════
model MarketingCampaign {
  id              Int       @id @default(autoincrement())
  name            String
  type            String    // REATIVACAO | ANIVERSARIO | INDICACAO | PROMOCAO
  trigger         String    @default("MANUAL") // MANUAL | AUTO
  messageTemplate String    @map("message_template")
  segmentFilter   String    @default("{}") @map("segment_filter") // JSON critérios
  status          String    @default("DRAFT") // DRAFT | ACTIVE | PAUSED | COMPLETED
  sentCount       Int       @default(0) @map("sent_count")
  scheduledAt     DateTime? @map("scheduled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  adminId         Int       @map("admin_id")
  admin           Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("marketing_campaigns")
}

// ═══════════════════════════════════════════════════════════════
// 🏭 FORNECEDORES (CADASTRO POR CNPJ)
// ═══════════════════════════════════════════════════════════════
model Supplier {
  id                Int        @id @default(autoincrement())
  cnpj              String
  corporateName     String     @map("corporate_name") // Razão Social
  tradeName         String     @default("") @map("trade_name") // Nome Fantasia
  stateRegistration String     @default("") @map("state_registration") // Inscrição Estadual
  phone             String     @default("")
  email             String     @default("")
  address           String     @default("")
  category          String     @default("INSUMOS") // INSUMOS | EMBALAGENS | EQUIPAMENTOS | SERVICOS | OUTROS
  paymentTerms      String     @default("") @map("payment_terms") // Ex: "Boleto 30 dias", "Pix à vista"
  pixKey            String     @default("") @map("pix_key")
  bankInfo          String     @default("") @map("bank_info")
  notes             String     @default("")
  active            Boolean    @default(true)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @default(now()) @map("updated_at")

  adminId           Int        @map("admin_id")
  admin             Admin      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  purchases         Purchase[]
  invoices          Invoice[]

  @@index([adminId])
  @@index([cnpj])
  @@map("suppliers")
}

// ═══════════════════════════════════════════════════════════════
// 🛒 COMPRAS (PEDIDOS E GESTÃO DE FORNECIMENTO)
// ═══════════════════════════════════════════════════════════════
model Purchase {
  id                   Int            @id @default(autoincrement())
  purchaseNumber       String         @map("purchase_number") // Ex: "#CMP-1001"
  purchaseDate         String         @map("purchase_date") // "YYYY-MM-DD"
  expectedDeliveryDate String?        @map("expected_delivery_date") // "YYYY-MM-DD"
  receivedDate         String?        @map("received_date") // "YYYY-MM-DD"
  status               String         @default("PENDING") // PENDING | APPROVED | RECEIVED | CANCELLED
  paymentMethod        String         @default("BOLETO") @map("payment_method") // PIX | BOLETO | CARTAO | DINHEIRO | PRAZO
  paymentStatus        String         @default("PENDING") @map("payment_status") // PENDING | PAID | CANCELLED
  dueDate              String?        @map("due_date")
  totalAmount          Float          @default(0.0) @map("total_amount")
  notes                String         @default("")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @default(now()) @map("updated_at")

  adminId              Int            @map("admin_id")
  admin                Admin          @relation(fields: [adminId], references: [id], onDelete: Cascade)

  supplierId           Int?           @map("supplier_id")
  supplier             Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  invoiceId            Int?           @map("invoice_id")
  invoice              Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  items                PurchaseItem[]

  @@index([adminId])
  @@index([supplierId])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id              Int            @id @default(autoincrement())
  name            String
  category        String         @default("INSUMO")
  quantity        Float          @default(1.0)
  unit            String         @default("un") // un, kg, g, l, ml, pct, cx
  unitPrice       Float          @default(0.0) @map("unit_price")
  subtotal        Float          @default(0.0)
  notes           String         @default("")
  inventoryItemId Int?           @map("inventory_item_id")
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now()) @map("created_at")

  purchaseId      Int            @map("purchase_id")
  purchase        Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("purchase_items")
}

// ═══════════════════════════════════════════════════════════════
// 🧾 NOTAS FISCAIS (1 VALOR DE ENTRADA CONSOLIDADO + GASTOS DESTRINCHADOS)
// ═══════════════════════════════════════════════════════════════
model Invoice {
  id               Int           @id @default(autoincrement())
  invoiceNumber    String        @map("invoice_number") // Número da NF (ex: "123456")
  series           String        @default("")
  accessKey        String        @default("") @map("access_key") // Chave de 44 dígitos da NF-e (opcional)
  issueDate        String        @map("issue_date") // "YYYY-MM-DD"
  dueDate          String        @map("due_date") // "YYYY-MM-DD"
  totalAmount      Float         @default(0.0) @map("total_amount") // "apenas 1 valor de entrada" consolidado da NF
  paymentMethod    String        @default("BOLETO") @map("payment_method")
  paid             Boolean       @default(false)
  paidAt           String?       @map("paid_at")
  status           String        @default("REGISTRADA") // REGISTRADA | PAGA | CANCELADA
  attachmentUrl    String        @default("") @map("attachment_url")
  notes            String        @default("")
  transactionId    Int?          @map("transaction_id") // ID da transação vinculada no Financeiro
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @default(now()) @map("updated_at")

  // Direção e tipo de operação fiscal:
  direction        String        @default("ENTRADA") // "ENTRADA" (Compra/Insumos) | "SAIDA" (Venda para Cliente)
  operationType    String        @default("COMPRA") @map("operation_type") // "COMPRA" | "VENDA" | "DEVOLUCAO" | "SERVICO"
  clientName       String        @default("") @map("client_name")
  clientDocument   String        @default("") @map("client_document") // CPF ou CNPJ do destinatário
  clientEmail      String        @default("") @map("client_email")
  authorizationProtocol String   @default("") @map("authorization_protocol")
  qrCodeUrl        String        @default("") @map("qr_code_url")
  saleTransactionId Int?         @map("sale_transaction_id")
  orderId          Int?          @map("order_id")

  // Campos fiscais padrão SEFAZ:
  cfop             String        @default("")
  naturezaOperacao String        @default("COMPRA") @map("natureza_operacao")
  productsAmount   Float         @default(0.0) @map("products_amount")
  freightAmount    Float         @default(0.0) @map("freight_amount")
  discountAmount   Float         @default(0.0) @map("discount_amount")
  otherExpenses    Float         @default(0.0) @map("other_expenses")
  icmsAmount       Float         @default(0.0) @map("icms_amount")
  ipiAmount        Float         @default(0.0) @map("ipi_amount")
  pisAmount        Float         @default(0.0) @map("pis_amount")
  cofinsAmount     Float         @default(0.0) @map("cofins_amount")
  xmlContent       String        @default("") @map("xml_content")
  installments     String        @default("[]") // JSON de duplicatas/parcelas

  adminId          Int           @map("admin_id")
  admin            Admin         @relation(fields: [adminId], references: [id], onDelete: Cascade)

  supplierId       Int?          @map("supplier_id")
  supplier         Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  items            InvoiceItem[]
  purchases        Purchase[]

  @@index([adminId])
  @@index([adminId, direction])
  @@index([supplierId])
  @@index([invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id              Int            @id @default(autoincrement())
  description     String         // Nome do insumo / despesa destrinchada
  expenseCategory String         @default("INSUMOS") @map("expense_category") // INSUMOS | EMBALAGENS | FRETE | EQUIPAMENTOS | MANUTENCAO | CONSUMO | OUTROS
  quantity        Float          @default(1.0)
  unit            String         @default("un") // kg, g, l, un, pct, cx, etc.
  unitPrice       Float          @default(0.0) @map("unit_price")
  totalPrice      Float          @default(0.0) @map("total_price")
  itemCode        String         @default("") @map("item_code") // Código do produto no fornecedor (cProd)
  ncm             String         @default("")
  cfop            String         @default("")
  discount        Float          @default(0.0)
  inventoryItemId Int?           @map("inventory_item_id")
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now()) @map("created_at")

  invoiceId       Int            @map("invoice_id")
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ═══════════════════════════════════════════════════════════
// 🛒 BoraEnkomenda: Listas de Compras de Produção
// ═══════════════════════════════════════════════════════════

model ShoppingList {
  id          Int                @id @default(autoincrement())
  title       String
  description String             @default("")
  status      String             @default("ABERTA") // "ABERTA" | "CONCLUIDA"
  targetDate  DateTime?          @map("target_date") // data prevista da compra
  orderId     Int?               @map("order_id") // encomenda vinculada (opcional)
  order       Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items       ShoppingListItem[]

  adminId     Int                @map("admin_id")
  admin       Admin              @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @default(now()) @map("updated_at")

  @@index([adminId])
  @@index([orderId])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id             Int          @id @default(autoincrement())
  shoppingListId Int          @map("shopping_list_id")
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  name           String
  quantity       Float        @default(1)
  unit           String       @default("un") // "un", "kg", "g", "l", "ml", "pct", "cx", "lata"
  category       String       @default("Geral") // "Laticínios & Ovos", "Secos & Farinhas", "Embalagens", "Hortifruti", "Doces & Chocolates", "Geral"
  estimatedPrice Float        @default(0.0) @map("estimated_price")
  actualPrice    Float        @default(0.0) @map("actual_price")
  checked        Boolean      @default(false)
  checkedAt      DateTime?    @map("checked_at")
  notes          String       @default("")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @default(now()) @map("updated_at")

  @@index([shoppingListId])
  @@map("shopping_list_items")
}
