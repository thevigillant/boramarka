{
  "name": "sistema-marcacao-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate && tsc",
    "test": "vitest run",
    "seed": "tsx --env-file=.env prisma/seed.ts",
    "test-email": "tsx --env-file=.env src/scripts/testEmail.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:backup": "tsx --env-file=.env src/scripts/backupDb.ts"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.0",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.25.0",
    "mercadopago": "^3.1.0",
    "nodemailer": "^9.0.3",
    "pino-pretty": "^13.1.3",
    "resend": "^6.18.1",
    "uuid": "^9.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "@types/web-push": "^3.6.4",
    "prisma": "^5.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2",
    "vitest": "^4.1.10"
  }
}
